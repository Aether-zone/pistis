# Base URL of the Nest api, used only on the server: the browser never calls
# the api directly, so this is not a NEXT_PUBLIC_ variable.
#
# There is no safe default. Both the api and this app default to port 3000, so
# one of them always has to move — and pointing this at the wrong thing is the
# most common reason signing in fails. Copy to .env.local and set it to
# whatever port `pnpm --filter @pistis/api serve` is actually on.
PISTIS_API_URL=http://localhost:3001
