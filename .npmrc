strict-peer-dependencies=false
auto-install-peers=true
# pnpm 10's `deploy` refuses a workspace that does not inject, and its
# `--legacy` fallback exits non-zero even when it writes a correct tree, which
# fails `RUN pnpm deploy` in the image build. Injecting copies a workspace
# dependency into its consumer instead of symlinking it — which is what a
# self-contained deploy directory wants anyway.
inject-workspace-packages=true

