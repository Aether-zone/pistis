# Copy to api/.env. Loaded by main.ts via process.loadEnvFile(), so no dotenv
# dependency is involved; values already present in the environment win.

# Where the SQLite file lives, relative to the working directory unless absolute.
# DATABASE_PATH=db.sqlite

# Port, and the public origin this server calls itself in tokens and metadata.
PORT=3001
OAUTH_ISSUER=http://localhost:3001

# PEM RSA private key that signs access tokens and sessions. Without it a key
# is generated at every boot, so tokens do not survive a restart:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out oauth-signing.pem
# OAUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Lifetimes, in seconds.
# OAUTH_ACCESS_TOKEN_TTL=3600
# OAUTH_REFRESH_TOKEN_TTL=2592000
# OAUTH_AUTHORIZATION_CODE_TTL=600
# SESSION_TTL=43200

# Require PKCE from confidential clients too (public clients always need it).
# OAUTH_REQUIRE_PKCE=true

# Create a demo admin and client at boot. Development only — it refuses to run
# under NODE_ENV=production. Credentials are logged at startup.
OAUTH_DEV_SEED=true
OAUTH_DEV_SEED_REDIRECT_URIS=http://localhost:3002/callback
